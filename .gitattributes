# Ensure shell scripts always use LF line endings regardless of OS
# (CRLF endings break shebangs and heredocs on Linux runners)
scripts/*.sh text eol=lf
tests/*.sh   text eol=lf

# Ensure YAML uses LF (Windows editors sometimes write CRLF)
*.yml text eol=lf
*.yaml text eol=lf

# Treat everything else as auto
* text=auto
